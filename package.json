{
  "name": "routeprint",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.1"
  },
  "scripts": {
    "openspec:validate": "bin/openspec validate --all --strict",
    "frontend:audit": "npm audit --audit-level=high",
    "frontend:build": "RAILS_ENV=production vite build",
    "frontend:build:test": "RAILS_ENV=test bin/vite build",
    "frontend:format": "prettier --check --log-level warn \"app/frontend/**/*.{ts,tsx,css}\" vite.config.ts eslint.config.mjs package.json tsconfig.json components.json",
    "frontend:lint": "eslint . --quiet",
    "frontend:test": "vitest run --coverage --reporter=minimal --passWithNoTests",
    "frontend:typecheck": "tsc --noEmit --pretty false",
    "frontend:verify": "npm run frontend:format && npm run frontend:lint && npm run frontend:typecheck && npm run frontend:test && npm run frontend:build && npm run frontend:audit"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@inertiajs/vite": "3.11.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-ruby": "5.2.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@inertiajs/react": "3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.16.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "packageManager": "npm@12.2.1"
}
