# Allow direct, non-mutating Routeprint agent targets.
prefix_rule(
    pattern=[
        "make",
        [
            "agent-diff-names",
            "agent-diff-stat",
            "agent-docker-logs",
            "agent-state",
            "agent-host-search",
            "agent-host-diff-names",
            "agent-host-diff-stat",
            "agent-host-docker-logs",
            "agent-host-log",
            "agent-host-state",
            "agent-log",
            "agent-frontend-format",
            "agent-frontend-lint",
            "agent-frontend-typecheck",
            "agent-frontend-test",
            "agent-rspec",
            "agent-rubocop",
            "agent-ruby-test",
            "agent-search",
            "agent-test",
            "agent-verify-fast",
        ],
    ],
    decision="allow",
    justification="Direct Routeprint agent Make targets",
)

# Allow direct non-agent Routeprint Make checks.
prefix_rule(
    pattern=[
        "make",
        [
            "bundle-outdated",
            "ci",
            "doctor",
            "frontend-audit",
            "frontend-build",
            "frontend-check",
            "frontend-format",
            "frontend-lint",
            "frontend-outdated",
            "frontend-test",
            "frontend-typecheck",
            "frontend-verify",
            "harness-check",
            "lint",
            "openspec-validate",
            "outdated",
            "rubocop",
            "rubocop-check",
            "ruby-test",
            "security",
            "test",
            "verify",
            "verify-fast",
        ],
    ],
    decision="allow",
    justification="Direct non-agent Routeprint Make commands",
)

# Keep the explicit, user-scoped frontend formatter mutation target separate.
prefix_rule(
    pattern=["make", "agent-frontend-format-fix"],
    decision="allow",
    justification="Explicit Routeprint frontend formatter fix",
)
